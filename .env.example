# Auth.js / next-auth v5 — JWT sessions (no Redis required for Sign-in)
# Required for Google Sign-in:
AUTH_SECRET=
AUTH_URL=https://www.2oolzgenie.com
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Aliases also accepted (values are trimmed):
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional — Upstash Redis for cross-device lamp sync only (/api/lamp).
# Sign-in works without these; missing Redis → syncStatus "no-storage".
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Or Vercel KV REST (if you use that instead):
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
